# Copy to .env (never committed) to send through real providers:
#   cp .env.example .env && cp config/providers.real.example.json config/providers.real.json
#   then edit both and run: make up

# Which providers file the workers load (inside ./config)
PROVIDERS=providers.real.json

# Amazon SES: an IAM user with ses:SendEmail only (on EKS, use an IAM role instead of keys)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Twilio: prefer an API Key over the account Auth Token (revocable, scoped)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=
