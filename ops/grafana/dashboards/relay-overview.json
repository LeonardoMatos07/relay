        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(relay_dead_lettered_total[1m]))",
          "legendFormat": "DLQ {{reason}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rate-limit wait p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
