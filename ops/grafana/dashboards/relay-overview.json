          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (provider) (relay_circuit_breaker_state)",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Retries and dead letters (msg/s)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
